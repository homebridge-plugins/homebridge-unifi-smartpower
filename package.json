{
  "displayName": "UniFi SmartPower",
  "name": "@homebridge-plugins/homebridge-unifi-smartpower",
  "version": "2.4.0",
  "description": "UniFi SmartPower plugin for Homebridge.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/homebridge-plugins/homebridge-unifi-smartpower.git"
  },
  "bugs": {
    "url": "https://github.com/homebridge-plugins/homebridge-unifi-smartpower/issues"
  },
  "engines": {
    "homebridge": "^1.8.5 || ^2.0.0",
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "npm install && npm outdated",
    "eslint": "eslint src/**.ts --max-warnings=0",
    "eslint-fix": "eslint src/**.ts --max-warnings=0 --fix",
    "prettier": "prettier --check src *.{yaml,json,md}",
    "prettier-fix": "prettier --write src *.{yaml,json,md}",
    "lint": "npm run eslint",
    "lint-fix": "npm run eslint-fix && npm run prettier-fix",
    "fmt": "npm run lint-fix",
    "watch": "npm run build && npm link && nodemon",
    "build": "rm -rf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm run build",
    "test": "npm run eslint"
  },
  "keywords": [
    "homebridge-plugin",
    "unifi",
    "smart",
    "power",
    "smartpower"
  ],
  "dependencies": {
    "async-lock": "^1.4.1",
    "cache-manager": "^7.2.9",
    "cacheable": "^2.5.0",
    "keyv": "^5.6.0",
    "node-unifi": "^2.5.1",
    "pubsub-js": "^1.9.5"
  },
  "devDependencies": {
    "@types/async-lock": "^1.4.2",
    "@types/cache-manager": "^4.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.5.2",
    "@types/pubsub-js": "^1.8.6",
    "@typescript-eslint/eslint-plugin": "<8",
    "@typescript-eslint/parser": "<8",
    "eslint": "<9",
    "homebridge": "^2.4.0",
    "homebridge-config-ui-x": "^5.6.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "<5.6.0"
  }
}
